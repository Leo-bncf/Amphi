{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amphi",
  "version": "0.1.0",
  "identifier": "pro.amphi.studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Amphi",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "all"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Notes de cours",
    "longDescription": "Enregistre le cours, le transcrit sur ta machine et en tire des notes structurées et traçables."
  }
}
